*.safetensors
*.pt
*.pth
*.ckpt
checkpoints/
models/

# LoRA adapter weights — the configs are kept in the repo as documentation,
# but the saved safetensors are repo-local artefacts that bloat git history.
# `adapter_config.example.json` is the committed template; `adapter_config.json`
# is regenerated by `mlx_lm` on every train run and is project-local.
notebooks/adapters/*.safetensors
notebooks/adapters/adapters.*
notebooks/adapters/adapter_config.json

